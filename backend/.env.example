# Copy to backend/.env and fill in. Never commit the real file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://localshop:localshop@localhost:5432/localshop
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-char-random-hex-string
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
